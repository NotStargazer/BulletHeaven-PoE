%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 468381dbdc234d1cb143f6074042b47e, type: 3}
  m_Name: Scaler Modifier
  m_EditorClassIdentifier: Assembly-CSharp::UI.Localization.LocalizationAsset
  _entries:
  - Key: ScaleModifier.Flat
    Strings:
    - Additions and Subtractions to #Scaler# also apply to #StatType#{"HasEffect"|
      at #Multiplier#% effect}{"Conditional"| #Condition#}
    - 
  - Key: ScaleModifier.Increased
    Strings:
    - Increases and Decreases to #Scaler# also apply to #StatType#{"HasEffect"| at
      #Multiplier#% effect}{"Conditional"| #Condition#}
    - 
  - Key: ScaleModifier.Multiplier
    Strings:
    - More and Less modifiers to #Scaler# also apply to #StatType#{"HasEffect"| at
      #Multiplier#% effect}{"Conditional"| #Condition#}
    - 
  - Key: ScaleModifier.Fixed
    Strings:
    - '#StatType# is equal to{"HasEffect" |#Multiplier#x of } #Scaler#{"Conditional"|
      #Condition#}'
    - 
